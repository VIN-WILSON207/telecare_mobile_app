rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isApprovedDoctor() {
      return userRole() == 'doctor'
        && userDoc().data.verificationStatus == 'approved';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    match /verification_requests/{requestId} {
      allow create: if isSignedIn() && (userRole() == 'doctor' || userRole() == 'nurse' || userRole() == 'labTechnician');
      allow read: if isSignedIn() && (resource.data.doctorId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
    }

    match /consultations/{consultationId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
    }

    match /medical_records/{recordId} {
      allow create: if (isApprovedDoctor() || userRole() == 'nurse' || userRole() == 'labTechnician')
        && request.resource.data.patientId is string;

      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /health_tips/{tipId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isApprovedDoctor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
